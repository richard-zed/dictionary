<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions. The dictionary is baked in; nothing is fetched. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iris">

        <!--
          The app proper. Bonus, not the point.

          windowSoftInputMode="adjustResize" is required alongside
          enableEdgeToEdge. Without it the window and Compose both account for
          the keyboard: the system shrinks the window and safeDrawingPadding
          subtracts the IME inset again, leaving the search field roughly half a
          screen too high.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Iris">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share-sheet target. The hosts that refuse to show the
              PROCESS_TEXT action still hand text to the share sheet, and this
              is the only route that reaches every one of them, including
              Termux, which has no TextView and therefore never builds a
              selection toolbar at all.

              Three taps instead of one (select, share, Dictionary), so this is
              a fallback and not a replacement for the overlay. It costs no
              permission and no resident service, which is what made it worth
              having over an accessibility service.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The overlay. This is the point of the app.

          ACTION_PROCESS_TEXT is the only system-wide way to receive highlighted
          text on Android. It is not a floating popover the way iOS Lookup is:
          it launches this activity over the source app, hands over the string,
          and the user backs out to return. That difference is a presentation
          limit, not something an implementation detail can fix. The platform
          offers no popover-shaped contract.

          themeTranslucent keeps the takeover from reading as a full app launch.
          -->
        <activity
            android:name=".LookupActivity"
            android:exported="true"
            android:label="@string/lookup_label"
            android:theme="@style/Theme.Iris.Translucent"
            android:excludeFromRecents="true"
            android:launchMode="singleTop">
            <!--
              icon and label live on the FILTER, not the activity. The
              selection toolbar reads the filter's icon, so without them the
              entry renders as bare text with no glyph.

              PROCESS_TEXT_READONLY covers selections the host considers
              read-only, which is most browser and reader text. A host that
              queries only that action would not list this activity at all.

              text/* is declared alongside text/plain because some hosts probe
              with the wildcard rather than the concrete type.

              No <queries> here: that element belongs on the HOST side to see
              PROCESS_TEXT activities. Nothing in this manifest can reach it.
            -->
            <intent-filter
                android:priority="1000"
                android:icon="@mipmap/ic_launcher"
                android:label="@string/lookup_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <action android:name="android.intent.action.PROCESS_TEXT_READONLY" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
